PORT=5000

# Comma-separated dashboard origins allowed (Socket.IO + REST)
CLIENT_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=monitor

# How often the cron runs (default: every 5 minutes)
CHECK_CRON=*/5 * * * *

# Dead-man's-switch heartbeat (Healthchecks.io / UptimeRobot / Cronitor ping URL)
HEARTBEAT_URL=

# Microsoft Teams Workflows incoming-webhook URL (site/API failure alerts)
TEAMS_WEBHOOK_URL=

# Auth — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES=7d

# Legacy single-target fallback (targets are managed in the DB now)
WEBSITE_URL=https://example.com
API_URL=https://example.com/api/health
BROWSER_URL=https://example.com

# SMTP for email alerts
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USER=you@example.com
MAIL_PASS=your-mail-password
FROM_EMAIL="Website Monitor <you@example.com>"
ALERT_TO=alerts@example.com
